#!/usr/bin/env sh
set -e

# The workspace is pinned to Bun, while GUI Git clients often do not inherit
# the user's Bun PATH. Prefer a local/global Bun and fall back to the pinned
# version through npx so Turbo can always resolve the package manager binary.
if command -v bun >/dev/null 2>&1; then
  run_bun() {
    bun "$@"
  }
else
  run_bun() {
    npx --yes bun@1.3.1 "$@"
  }
fi

run_bun run test

# lint-staged handles partially staged files and restores them transactionally.
# Avoid maintaining a second stash/pop implementation here: formatter changes
# can otherwise conflict with the hook's own backup during a merge commit.
if [ -z "$(git diff --cached --name-only)" ]; then
  echo "No staged files to format"
  exit 0
fi

run_bun x lint-staged
